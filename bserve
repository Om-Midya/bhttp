#!/usr/bin/env python3
"""bserve: bhttp/1 static file server.

    ./bserve ROOT PORT

Serves files under ROOT.  One connection carries any number of requests.
Logs one line per request to stdout.
"""
import email.utils
import io
import mimetypes
import os
import socketserver
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bhttp as B  # noqa: E402

SERVER = "bserve/1"
CHUNK = 16384          # body bytes per DATA frame; HTTP/2 uses the same default
IDLE_TIMEOUT = 30


def log(*parts):
    print(*parts, flush=True)


def resolve(root, path):
    """Map a request path to a file under root.  Returns None if there is no file."""
    if path.endswith("/"):
        path += "index.html"
    full = os.path.realpath(os.path.join(root, path.lstrip("/")))
    if not full.startswith(root + os.sep):     # escaped the root via '..' or a symlink
        return None
    return full if os.path.isfile(full) else None


class Handler(socketserver.StreamRequestHandler):
    timeout = IDLE_TIMEOUT      # seconds a connection can sit idle between frames

    def handle(self):
        peer = "%s:%d" % self.client_address[:2]
        while True:
            try:
                frame = B.read_frame(self.rfile)
            except (EOFError, OSError) as e:   # truncated frame, idle timeout, or reset
                log(peer, "close:", e)
                return
            if frame is None:                     # clean EOF at a frame boundary
                return
            if frame.type != 0 and frame.type not in B.KNOWN_TYPES:
                log(peer, "skip", frame.describe())
                continue
            try:
                if frame.type != B.T_REQUEST:
                    raise B.Malformed("unexpected frame type 0x%02x" % frame.type)
                if frame.rid == 0:
                    raise B.Malformed("request id 0 is reserved")
                method, path, _ = B.decode_request(frame.payload)
                if method not in B.METHOD_NAMES:
                    raise B.Malformed("unknown method 0x%02x" % method)
            except B.Malformed as e:
                log(peer, "#%d 400 %s" % (frame.rid, e))
                self.reply(frame.rid, 400, [("reason", str(e))], io.BytesIO(b"400 Bad Request\n"), 16, False)
                continue
            status, headers, body, size = self.serve(path)
            log(peer, "#%d %s %s -> %d %dB" % (frame.rid, B.METHOD_NAMES[method], B.printable(path), status, size))
            try:
                with body:
                    self.reply(frame.rid, status, headers, body, size, method == B.M_HEAD)
            except OSError as e:
                log(peer, "close:", e)
                return

    def serve(self, path):
        """Returns (status, headers, body file object, body size).  The caller closes the body."""
        full = resolve(self.server.root, path)
        if full is None:
            return 404, [("reason", "no such file")], io.BytesIO(b"404 Not Found\n"), 14
        try:
            f = open(full, "rb")
            st = os.fstat(f.fileno())
        except OSError as e:
            return 500, [("reason", e.strerror or "read error")], io.BytesIO(b"500 Internal Server Error\n"), 26
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        return 200, [
            ("content-type", ctype),
            ("last-modified", email.utils.formatdate(st.st_mtime, usegmt=True)),
            ("etag", '"%x-%x"' % (st.st_mtime_ns, st.st_size)),
        ], f, st.st_size

    def reply(self, rid, status, headers, body, size, head_only):
        headers = [("server", SERVER),
                   ("date", email.utils.formatdate(usegmt=True)),
                   ("content-length", str(size))] + headers
        has_body = size > 0 and not head_only
        self.wfile.write(B.Frame(B.T_RESPONSE, 0 if has_body else B.F_END, rid,
                                 B.encode_response(status, headers)).pack())
        sent = 0
        while has_body and sent < size:            # stream CHUNK bytes at a time; never holds the whole file
            chunk = body.read(min(CHUNK, size - sent))
            if not chunk:
                raise OSError("file shrank while sending")
            sent += len(chunk)
            self.wfile.write(B.Frame(B.T_DATA, B.F_END if sent == size else 0, rid, chunk).pack())
        self.wfile.flush()


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


def main(argv):
    if len(argv) != 3:
        sys.exit("usage: bserve ROOT PORT")
    root = os.path.realpath(argv[1])
    if not os.path.isdir(root):
        sys.exit("bserve: %s is not a directory" % argv[1])
    with Server(("", int(argv[2])), Handler) as srv:
        srv.root = root
        log("bserve: serving %s on port %d" % (root, srv.server_address[1]))
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main(sys.argv)
